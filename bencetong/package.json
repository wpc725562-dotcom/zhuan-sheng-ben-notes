{
  "name": "bencetong",
  "version": "2.0.0",
  "description": "本科通 - 广东专升本学习助手",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:preview": "vite build && electron ."
  },
  "build": {
    "appId": "com.bencetong.app",
    "productName": "本科通",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "本科通"
    }
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "pinia": "^2.3.0",
    "marked": "^15.0.0",
    "highlight.js": "^11.11.0",
    "dompurify": "^3.1.6"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "vite": "^6.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "concurrently": "^9.1.0",
    "wait-on": "^8.0.0",
    "cross-env": "^7.0.3"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true,
    "vue-demi@0.14.10": true
  }
}
